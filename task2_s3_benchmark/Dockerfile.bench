FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    s3fs \
    fuse \
    ca-certificates \
    curl \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -f /etc/fuse.conf ]; then sed -i 's/^#user_allow_other/user_allow_other/' /etc/fuse.conf; fi

RUN curl -fsSL https://github.com/kahing/goofys/releases/download/v0.24.0/goofys -o /usr/local/bin/goofys \
    && chmod +x /usr/local/bin/goofys

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY benchmark/ ./benchmark/
COPY scripts/mount_s3.sh ./scripts/mount_s3.sh
RUN chmod +x /app/scripts/mount_s3.sh \
    && mkdir -p /mnt/s3fs /mnt/goofys /app/results

ENTRYPOINT ["/app/scripts/mount_s3.sh"]
CMD ["python3", "-m", "benchmark.main"]
